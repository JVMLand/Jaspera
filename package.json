{
  "name": "jalweb",
  "version": "2026.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup": "tsx scripts/setup.ts",
    "build:compiler": "tsx scripts/build-compiler.ts",
    "generate": "tsx scripts/generate.ts",
    "typecheck": "pnpm run generate && tsc --noEmit && pnpm run typecheck:scripts",
    "perf": "tsx scripts/measure-workspace-performance.ts",
    "build": "pnpm run typecheck && vite build && tsx scripts/build-offline.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "prebuild": "tsx scripts/check-runtime.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cloudflare": "pnpm run build && tsx scripts/prepare-cloudflare.ts",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "predev": "pnpm run generate",
    "pretest": "pnpm run generate"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "antlr4": "4.13.2",
    "comlink": "^4.4.2",
    "elkjs": "^0.12.0",
    "fflate": "0.8.2",
    "i18next": "^26.4.2",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "@types/turndown": "^5.0.6",
    "@types/wawoff2": "1.0.2",
    "esbuild": "0.25.12",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "tsx": "^4.23.13",
    "turndown": "7.2.0",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "wawoff2": "2.0.1",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.129.1"
  },
  "packageManager": "pnpm@10.13.1"
}
