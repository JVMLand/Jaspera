{
  "name": "jalweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "build:compiler": "node scripts/build-compiler.mjs",
    "generate": "node scripts/generate-language.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "prebuild": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "antlr4": "4.13.2",
    "comlink": "^4.4.2",
    "fflate": "0.8.2",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12",
    "turndown": "7.2.0",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  }
}
