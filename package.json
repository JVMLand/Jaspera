{
  "name": "jalweb",
  "version": "2026.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "build:compiler": "node scripts/build-compiler.mjs",
    "generate": "node scripts/generate-language.mjs",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/measure-workspace-performance.mjs",
    "build": "pnpm run generate && pnpm run typecheck && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cloudflare": "pnpm run build && node scripts/prepare-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "antlr4": "4.13.2",
    "comlink": "^4.4.2",
    "elkjs": "^0.12.0",
    "fflate": "0.8.2",
    "i18next": "^26.4.2",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "esbuild": "0.25.12",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "turndown": "7.2.0",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.129.1"
  },
  "packageManager": "pnpm@10.13.1"
}
