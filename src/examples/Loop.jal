// 1 から 5 まで表示する。ローカル変数 #1 をカウンターに使う。
public class examples/Loop {
  public static main([Ljava/lang/String;)V {
    iconst_1
    istore_1
    Loop:
    iload_1
    iconst_5
    if_icmpgt Done
    getstatic java/lang/System->out:Ljava/io/PrintStream;
    iload_1
    invokevirtual java/io/PrintStream->println(I)V
    iinc 1 1
    goto Loop
    Done:
    return
  }
}
