{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    {
      "token": "",
      "foreground": "a9b7c6"
    },
    {
      "token": "keyword",
      "foreground": "cc7832"
    },
    {
      "token": "string",
      "foreground": "6a8759"
    },
    {
      "token": "number",
      "foreground": "6897bb"
    },
    {
      "token": "comment",
      "foreground": "808080"
    },
    {
      "token": "function",
      "foreground": "ffc66d"
    },
    {
      "token": "type",
      "foreground": "769aa5"
    },
    {
      "token": "identifier",
      "foreground": "a9b7c6"
    },
    {
      "token": "delimiter",
      "foreground": "a9b7c6"
    }
  ],
  "colors": {
    "editor.background": "#2b2b2b",
    "editor.foreground": "#a9b7c6",
    "editor.selectionBackground": "#214283",
    "editorCursor.foreground": "#bbbbbb",
    "editor.lineHighlightBackground": "#323232",
    "editorLineNumber.foreground": "#606366",
    "editorWidget.background": "#46484a"
  }
}
