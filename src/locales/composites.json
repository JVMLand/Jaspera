{
  "m13181c191a75": [
    {
      "key": "ha9f53a658272",
      "text": "標準入力"
    },
    {
      "key": "h806d0e402376",
      "text": "Console を消去"
    },
    {
      "key": "mdaaed0138661",
      "text": "問題は見つかりませんでした。"
    }
  ],
  "m7b8bfb66b6a4": [
    {
      "key": "h380af31a91bb",
      "text": "最初に開く Hello World で，文字列を出力してみましょう。"
    },
    {
      "key": "h588a0891d366",
      "text": "右上の"
    },
    {
      "key": "h3939a2f247b3",
      "text": "を押します。"
    },
    {
      "key": "ha69df4de8da9",
      "text": "の直前で止まったら，Debug のスタックを見ます。出力先と"
    },
    {
      "key": "h92e4a9a0acb0",
      "text": "が積まれています。"
    },
    {
      "key": "hd3464a775b97",
      "text": "で再開すると，Console に文字列が表示されます。"
    },
    {
      "key": "h937c067cee46",
      "text": "Hello World には，あらかじめブレークポイントが置かれています。行番号とオフセットの間をクリックすると解除できます。停止箇所がなければ，最後まで実行します。"
    },
    {
      "key": "h1c0b2141a7f7",
      "text": "サンプルを書き換える"
    },
    {
      "key": "he93c9fe9f69c",
      "text": "PROJECT の"
    },
    {
      "key": "h235ce880e68c",
      "text": "には，演算・分岐・ループ・配列などのプログラムがあります。数値や命令を変えて試してください。編集内容はリロードで元に戻ります。残したいときは"
    },
    {
      "key": "h0cc7030ca99f",
      "text": "File → JAL に書き出す…"
    },
    {
      "key": "h5e6db9317e73",
      "text": "で保存します。"
    }
  ],
  "m2181264bd49b": [
    {
      "key": "h5018c11db1f1",
      "text": "命令名を入力すると，補完候補が出ます。"
    },
    {
      "key": "h6a8f5a639349",
      "text": "や"
    },
    {
      "key": "hef9e60ab8a2d",
      "text": "の後では，フィールドやメソッドも補完できます。"
    },
    {
      "key": "h3a3e63ea8836",
      "text": "エラーを直す"
    },
    {
      "key": "h98d422fa8462",
      "text": "下線のある箇所にマウスを置くと，診断を読めます。Problems には診断が一覧で並び，押すと該当箇所へ移動します。修正候補がある場合は"
    },
    {
      "key": "h01ffcd07d7cc",
      "text": "で選べます。"
    },
    {
      "key": "h91cb0c3616f5",
      "text": "インデントをそろえる"
    },
    {
      "key": "h59734d0d963e",
      "text": "で整形します。ラベルは命令より一段外側，メソッド宣言と同じ深さにそろいます。"
    },
    {
      "key": "he49f8d2a206c",
      "text": "行番号の隣の数値"
    },
    {
      "key": "h0b3b5899f45c",
      "text": "メソッド先頭からのバイトコードオフセットです。命令の大きさから計算しているため，ビルドを待たずに更新されます。コンパイル時の命令の短縮や拡張によって，実際の値と異なる場合があります。"
    }
  ],
  "me9b789cbc18a": [
    {
      "key": "h0413a0b875a6",
      "text": "Instructions で命令の意味と使用例を調べられます。検索欄を押すと，カテゴリと命令の一覧が開きます。命令を選ぶと一覧が閉じ，本文が表示されます。"
    },
    {
      "key": "h11de71ea7b48",
      "text": "エディタで命令をクリックしても，その説明に切り替わります。使用例の命令にマウスを置くと，前後のフレームを確認できます。"
    },
    {
      "key": "hb8cdf85fe3ee",
      "text": "スタックの図を読む"
    },
    {
      "key": "h9874a3f42064",
      "text": "TOP が付いた値が，スタックの一番上です。命令が消費する値を赤，追加する値を緑で示します。ローカル変数を書き換える命令では，その変化も表示します。"
    },
    {
      "key": "had4e77ce02ed",
      "text": "編集中の命令にマウスを置くと，その位置のソースを解析した実行前後が表示されます。実行を止めて値を見る場合は Debug を使います。"
    }
  ],
  "mbb71c6101eac": [
    {
      "key": "hc90ab2f964b7",
      "text": "止めたい命令の行番号とオフセットの間をクリックし，ブレークポイントを置きます。Run を押すと，その命令を実行する直前で止まります。"
    },
    {
      "key": "h586646de45c7",
      "text": "一命令ずつ進める"
    },
    {
      "key": "hadb749243b41",
      "text": "次のブレークポイントまで再開"
    },
    {
      "key": "h8674049d2fe1",
      "text": "次の命令へ進む。呼び出し先はまとめて実行"
    },
    {
      "key": "h82ef982a1635",
      "text": "呼び出し先のメソッドへ入る"
    },
    {
      "key": "h6a2aa95bbb0a",
      "text": "現在のメソッドから戻るまで進む"
    },
    {
      "key": "h527929b8db37",
      "text": "画面下部のボタンからも操作できます。実行を中止するには Stop を押します。"
    },
    {
      "key": "hf7c2eeeda1ee",
      "text": "フレームを読む"
    },
    {
      "key": "ha2f14dfefb75",
      "text": "Debug の「現在」は停止時点の値，「実行後」は次の命令による変化です。メソッドの戻り値など，まだ分からない値は型や未確定の値として表示します。「（変更無し）」では同じ内容を一列にまとめます。"
    },
    {
      "key": "h5ed856e50ada",
      "text": "呼び出し元のフレームを選ぶと，呼び出した時点の値を確認できます。実行位置はソース上でも強調されます。ネイティブメソッドの内部にはステップインできません。"
    }
  ],
  "m2dc130c433c9": [
    {
      "key": "hf85be6f4c1b6",
      "text": "Graph は，開いているクラスの各メソッドを図にします。先にメソッドの枠が現れ，解析が終わったものから命令と線が表示されます。"
    },
    {
      "key": "hff86f3b4c552",
      "text": "上部のチェックで，スタック・ローカル変数・制御フロー・例外の線を切り替えられます。線が多いときは，調べたい関係だけを表示すると追いやすくなります。"
    },
    {
      "key": "he9df8f115226",
      "text": "命令をクリック：ソースの該当箇所へ移動"
    },
    {
      "key": "h2824d3d21aa3",
      "text": "背景をドラッグ：図を移動"
    },
    {
      "key": "he1f51896dd4d",
      "text": "ホイール：拡大・縮小"
    },
    {
      "key": "h640a88f8e578",
      "text": "命令はブロックごとに囲まれています。例外の線は保護された範囲からハンドラへ伸び，同じ経路の例外は一本にまとまります。"
    }
  ],
  "mab41ecfbaa24": [
    {
      "key": "h614f4a9c9ddd",
      "text": "を2回押すと，ファイル・クラス・メンバーをまとめて検索できます。名前の一部を入力して，候補を選んでください。"
    },
    {
      "key": "h5e8d9ed734ab",
      "text": "ソースから定義へ移動する"
    },
    {
      "key": "h24deae21ede8",
      "text": "クラスやメンバーを"
    },
    {
      "key": "hbd1b21e075ab",
      "text": "を押しながらクリックするか，カーソルを置いて"
    },
    {
      "key": "hc5526eaa4802",
      "text": "を押します。OpenJDK のクラスも JAL に逆アセンブルして開きます。"
    },
    {
      "key": "heda3c187382a",
      "text": "ラベルは"
    },
    {
      "key": "h15043ee51062",
      "text": "＋クリックで，定義または使用箇所に移動します。"
    },
    {
      "key": "ha21f43654009",
      "text": "class ファイルを読む"
    },
    {
      "key": "hc2c2ce72a635",
      "text": "File → 開く…"
    },
    {
      "key": "ha2e54fdcf32b",
      "text": "で"
    },
    {
      "key": "h5c49b73e6f83",
      "text": "を選ぶか，画面へドラッグ＆ドロップします。フォルダーを開いていなくても使えます。表示した JAL は"
    },
    {
      "key": "h0cc7030ca99f",
      "text": "File → JAL に書き出す…"
    },
    {
      "key": "hbd28c556963f",
      "text": "で保存できます。"
    }
  ],
  "maa27985d5312": [
    {
      "key": "h75ff526a1330",
      "text": "複数のソースを扱うときは"
    },
    {
      "key": "h9dd54f36f83f",
      "text": "File → フォルダーを開く…"
    },
    {
      "key": "hf0e52b543549",
      "text": "で作業フォルダーを選びます。プロジェクト設定は"
    },
    {
      "key": "h69ed02741873",
      "text": "，ソースは"
    },
    {
      "key": "hd2f170fb64aa",
      "text": "などの個別ファイルに保存します。"
    },
    {
      "key": "h70075e340ca0",
      "text": "設定ファイルのないフォルダーも開けます。"
    },
    {
      "key": "hc2c2ce72a635",
      "text": "File → 開く…"
    },
    {
      "key": "ha2e54fdcf32b",
      "text": "で"
    },
    {
      "key": "h71e061e4d281",
      "text": "を選んだ場合は，続けてソースのあるフォルダーを選択します。"
    },
    {
      "key": "hcca40df5468f",
      "text": "実行するファイルを変える"
    },
    {
      "key": "hb33465d4ad4e",
      "text": "File → プロジェクトのプロパティ…"
    },
    {
      "key": "h279bf8b76c81",
      "text": "で指定します。新規プロジェクトの初期設定は"
    },
    {
      "key": "hca700cc7c3c5",
      "text": "です。"
    },
    {
      "key": "h668e26e8a200",
      "text": "変更を保存する"
    },
    {
      "key": "h3e731bb6f55b",
      "text": "File → 保存"
    },
    {
      "key": "hf4ac771c1a80",
      "text": "を選びます。プロジェクトにはタブや小窓の配置も保存されます。"
    },
    {
      "key": "hf023b9723f23",
      "text": "の編集内容は含みません。"
    },
    {
      "key": "hd541c1ad1fca",
      "text": "フォルダーへ直接保存できないブラウザでは"
    },
    {
      "key": "m36581f447816",
      "text": "ZIP に書き出す…"
    },
    {
      "key": "hcda797fecc5d",
      "text": "を使えます。外部でファイルが変わると，約1秒ごとの確認で反映されます。未保存の編集と競合した場合は，編集内容を残して通知します。"
    }
  ],
  "m4caec0734b09": [
    {
      "key": "h660d9322b9eb",
      "text": "タブを少し長押ししてからドラッグすると，別のグループへ移せます。PROJECT のファイルも，開きたいグループへドラッグできます。"
    },
    {
      "key": "m8af85266ba4f",
      "text": "小窓で開く"
    },
    {
      "key": "h679e89ee8571",
      "text": "タブを画面の外へ持ち出すか，右クリックして「小窓で開く」を選びます。Instructions や Graph などのパネルも移動できます。小窓のタブがなくなると，窓は閉じます。"
    },
    {
      "key": "h97ef031012cf",
      "text": "タブの × はマウスを重ねると現れます。"
    },
    {
      "key": "h6e49a66589a8",
      "text": "＋クリックで，同じグループのほかのタブを閉じます。グループの境界をドラッグすると幅や高さを変えられます。"
    },
    {
      "key": "h953a0fb5229e",
      "text": "テーマを変える"
    },
    {
      "key": "h62f594c8c8c9",
      "text": "View → テーマ…"
    },
    {
      "key": "h87a4efc83d69",
      "text": "から選びます。色だけでなく，タブやパネルの見た目も変わります。選択はこのブラウザに保存されます。"
    }
  ],
  "m884b8b3a0c56": [
    {
      "key": "hada593693124",
      "text": "よく使う操作をキーボードから呼び出せます。macOS では，表の Ctrl を ⌘ に読み替えてください。"
